{
  "name": "galactic-adventure",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": { "url": "db/galactic.db" }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "alice": { "password": "alice", "roles": ["GalacticAdmin"],  "attr": { "planet": "EARTH" } },
          "bob":   { "password": "bob",   "roles": ["GalacticViewer"], "attr": { "planet": "EARTH" } },
          "zorg":  { "password": "zorg",  "roles": ["GalacticAdmin"],  "attr": { "planet": "XENON" } }
        }
      }
    }
  }
}
